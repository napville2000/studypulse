# StudyPulse Coach settings. Do NOT put this file in the repo.
# Copy it to %LOCALAPPDATA%\StudyPulseCoach\.env (Windows) or ~/.studypulse-coach/.env
# The authorize script fills in the *_REFRESH_TOKEN and *_EMAIL lines for you.

# Google Cloud OAuth client (type: Desktop app) — see SETUP.md step 2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Filled in by: npm run authorize:student   (daughter's school account)
CLASSROOM_REFRESH_TOKEN=
STUDENT_EMAIL=

# Filled in by: npm run authorize:parent    (your Gmail account)
GMAIL_REFRESH_TOKEN=
PARENT_EMAIL=

# College portal — the address you type to log in. The probe detects which system it is.
LMS_PORTAL_URL=

# Canvas (….instructure.com): Account > Settings > + New Access Token. Any Canvas link works for the base URL.
CANVAS_BASE_URL=
CANVAS_TOKEN=

# Any portal: the calendar feed (subscribe/export) URL, if it offers one
LMS_ICS_URL=

# Your Anthropic API key (same one you use in StudyPulse)
ANTHROPIC_API_KEY=

# Optional: path to your local clone of the studypulse repo (defaults to the clone this script is in)
REPO_PATH=

# Phase 3 only — the Apps Script relay
RELAY_URL=
